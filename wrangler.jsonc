{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tally",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // One Durable Object per group holds its encrypted log (worker/group-log.ts).
  "durable_objects": {
    "bindings": [{ "name": "GROUP_LOG", "class_name": "GroupLog" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GroupLog"] }],
  // Per-IP caps on relay connections and on new groups, per Cloudflare location.
  // Generous, since many phones share an IP behind mobile carriers' NAT.
  "ratelimits": [
    { "name": "CONNECT_LIMIT", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "CREATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
  ],
  // Keep logs to what the Worker prints itself (errors only). Invocation logs
  // would record request paths, and those contain group IDs.
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
  },
}

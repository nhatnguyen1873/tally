{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tally",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // Keep logs to what the Worker prints itself (errors only). Invocation logs
  // would record request paths, and those contain group IDs.
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
  },
}
